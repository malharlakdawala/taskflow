# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Postgres — Dashboard → Connect → ORMs → Prisma
# Use the Transaction pooler string (port 6543) so it works on serverless.
# TaskFlow's tables live in the `taskflow` schema; that is selected in
# src/lib/prisma.ts, so do NOT append ?schema=... here.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# No service-role key is needed. All writes go through the app's own connection
# with RLS as the backstop — including invitations, which is why they are a table
# here rather than Supabase's auth.admin.inviteUserByEmail (that needs the
# service-role key in production, which this project deliberately does without).

# ---------------------------------------------------------------------------
# Email notifications — Brevo (https://app.brevo.com). Entirely optional: with
# BREVO_API_KEY unset the app behaves exactly as before and simply sends no
# mail. Nothing here is exposed to the browser.
# ---------------------------------------------------------------------------

# Brevo → top-right menu → SMTP & API → API keys → Generate a new API key.
# The free plan allows 300 emails/day, which is well clear of normal use.
BREVO_API_KEY=xkeysib-...

# Must be a sender Brevo has verified, or every send is rejected with a 400:
# Brevo → Senders, domains & dedicated IPs → Senders → Add a sender, then click
# the confirmation link they email you. A plain address is enough — verifying a
# whole domain is only needed to remove the "via brevo" attribution.
EMAIL_FROM_ADDRESS=taskflow@your-domain.com
EMAIL_FROM_NAME=TaskFlow

# Worth setting if you plan to invite people: without it their invitation link
# cannot be mailed, so Settings → Members shows the link for you to pass on by
# hand instead. Everything else about invitations works either way.

# Absolute base for the links inside emails and MCP connect commands. On Vercel
# this is inferred from VERCEL_PROJECT_PRODUCTION_URL, so it is only needed for
# local testing or a custom domain. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Guards /api/cron/due-soon, the daily digest of overdue and soon-due tasks.
# Vercel sends this automatically as a bearer token once the variable exists on
# the project. Without it the route refuses every request rather than allowing
# anyone to trigger a workspace-wide mailout. Generate with:
#   openssl rand -hex 32
# The schedule lives in vercel.json and is in UTC; 30 2 * * * is 08:00 IST.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Seeding only. `npm run seed` uses this to create the demo accounts through
# the Supabase Auth admin API. Set it on the command line for that one command
# and then forget it — in a running deployment it would bypass row level
# security entirely.
#   SUPABASE_SERVICE_ROLE_KEY=<Project Settings → API → service_role>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Public demo instances only. See docs/DEMO.md. With DEMO_MODE on, the login
# screen shows these credentials so a visitor can get in without signing up —
# which also means a demo deployment must hold nothing real.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_EMAIL=ada@example.com
# NEXT_PUBLIC_DEMO_PASSWORD=taskflow-demo
