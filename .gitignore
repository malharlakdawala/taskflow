# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build output
/build
mcp-server/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local, the templates are committed
.env*
!.env.example
!mcp-server/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by `prisma generate` (runs via postinstall)
/src/generated/prisma
