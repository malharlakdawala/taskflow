# Same Postgres connection string as the web app's .env.local
# Dashboard → Connect → ORMs → Prisma (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Which TaskFlow account the MCP server acts as when creating tasks/comments.
# Must match an account that has signed up in the web app.
# Defaults to the earliest registered user if unset.
TASKFLOW_USER_EMAIL=you@example.com
