// TaskFlow data model.
//
// These tables live in the dedicated `taskflow` Postgres schema, NOT `public`,
// so they stay isolated from the CRM tables in the same Supabase project.
// The schema is selected at runtime by the driver adapter in src/lib/prisma.ts.
//
// DDL is owned by Supabase migrations, not `prisma migrate`. After changing this
// file run `npx prisma generate` and apply a matching SQL migration in Supabase.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Lets queries opt into a single JOIN instead of one round-trip per relation.
  // Round-trips to the Tokyo database cost ~140ms each, so this matters.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE

  @@map("task_status")
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE

  @@map("task_priority")
}

enum UserRole {
  ADMIN
  MEMBER

  @@map("user_role")
}

/// New sign-ups start PENDING and cannot read any data until an admin approves.
enum UserStatus {
  PENDING
  ACTIVE
  REJECTED

  @@map("user_status")
}

/// What an in-app notification is about. Field-level task edits (status,
/// priority, due date, title) collapse into one TASK_UPDATED row per save, so
/// changing three fields at once doesn't ring the bell three times.
enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENT
  TASK_DUE_SOON
  ACCOUNT_APPROVED

  @@map("notification_type")
}

/// Mirror of auth.users, kept in sync by the on_auth_user_created trigger.
/// `id` is deliberately the same uuid as the Supabase auth user id, so a session
/// user id can be used directly as a foreign key.
model User {
  id              String           @id @db.Uuid
  email           String           @unique
  name            String?
  avatarUrl       String?
  role            UserRole         @default(MEMBER)
  status          UserStatus       @default(PENDING)
  approvedAt      DateTime?        @db.Timestamptz(6)
  approvedById    String?          @db.Uuid
  approvedBy      User?            @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approved        User[]           @relation("UserApprovedBy")
  /// Mail-worthy events a member can dial down. Never gates the in-app feed —
  /// only whether a copy also goes out as email. Account approval and workspace
  /// invitations ignore these: they are the one mail a person who can't yet
  /// see the app needs to receive.
  emailOnAssigned Boolean          @default(true)
  emailOnComment  Boolean          @default(true)
  emailOnDueSoon  Boolean          @default(true)
  tasks           Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreatedBy")
  createdProjects Project[]        @relation("ProjectCreatedBy")
  projectMemberships ProjectMember[]
  comments        Comment[]
  notifications   Notification[]  @relation("NotificationRecipient")
  actedOn         Notification[]  @relation("NotificationActor")
  apiTokens       ApiToken[]
  invitationsSent Invitation[]     @relation("InvitationInvitedBy")
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@index([status], map: "User_status_idx")
}

/// An open offer of membership, addressed to an email that has no account yet.
///
/// Only the token's hash is stored, so the plaintext exists in exactly one
/// place: the invitation email. Accepting requires presenting it — see the
/// migration for why matching on the email address alone is not enough.
///
/// `email` is written lower-cased by the API, which is what makes the unique
/// index case-insensitive in practice. Re-inviting an address updates this row
/// and issues a new token rather than creating a second one.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  role        UserRole  @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?   @db.Uuid
  invitedBy   User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime  @db.Timestamptz(6)
  /// Set when the invited person claims it. Kept as a record of how a member
  /// came to be one.
  acceptedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
}

/// A named grouping for tasks. Membership is optional — a task with no project
/// is unfiled, which the UI shows as "No project".
///
/// Note: the database also holds a case-insensitive unique index on `name`
/// (`Project_name_lower_key`). Prisma cannot express a functional index, so it
/// is absent from this model and only enforced by Postgres — a duplicate name
/// arrives as P2002 rather than being caught by the client.
model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// A palette key from src/lib/types.ts, never free-form CSS.
  color       String?
  /// Archived projects keep their tasks but leave the sidebar and the pickers.
  archived    Boolean         @default(false)
  createdById String?         @db.Uuid
  createdBy   User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks       Task[]
  /// Who may see or edit this project's tasks at all. Global admins bypass
  /// this entirely — see `taskflow.is_admin()`. A task with no project is
  /// unfiled and stays visible to every active member regardless.
  members     ProjectMember[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
}

enum ProjectRole {
  /// Read-only: sees the project's tasks, cannot create, edit or delete them.
  VIEWER
  /// Full task CRUD within the project, and can manage its membership.
  EDITOR

  @@map("project_role")
}

/// One row per (project, user) who may access it. The project's creator gets
/// one automatically, as EDITOR, at creation.
model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(EDITOR)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([projectId, userId], map: "ProjectMember_projectId_userId_key")
  @@index([userId], map: "ProjectMember_userId_idx")
}

model Task {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  description   Json?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(NONE)
  /// When work on this task is planned to begin. Optional, and independent of
  /// status — starting the clock is a planning decision, not a state change.
  /// Powers the Gantt view; `dueDate` doubles as the end of its bar there.
  startDate     DateTime?      @db.Timestamptz(6)
  dueDate       DateTime?      @db.Timestamptz(6)
  order         Float          @default(0)
  /// Null means unfiled. Deleting a project clears this rather than the task.
  projectId     String?        @db.Uuid
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId    String?        @db.Uuid
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String?        @db.Uuid
  createdBy     User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Null means top-level. A subtask is an ordinary task otherwise — same
  /// status, assignee and notifications — that is filed under another one and
  /// left off the board, list and calendar so it doesn't double-count there.
  /// Nesting is one level deep: the API refuses to give a subtask subtasks of
  /// its own, which is what "on delete cascade" here relies on — a subtask
  /// deleted with its parent is never itself a parent.
  parentId      String?        @db.Uuid
  parent        Task?          @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("TaskSubtasks")
  comments      Comment[]
  attachments   Attachment[]
  tags          TaskTag[]
  notifications Notification[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  @@index([status], map: "Task_status_idx")
  @@index([assigneeId], map: "Task_assigneeId_idx")
  @@index([priority], map: "Task_priority_idx")
  @@index([status, order], map: "Task_order_idx")
  @@index([projectId], map: "Task_projectId_idx")
  @@index([parentId], map: "Task_parentId_idx")
}

model Comment {
  id            String         @id @default(uuid()) @db.Uuid
  content       Json
  taskId        String         @db.Uuid
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId      String         @db.Uuid
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  @@index([taskId], map: "Comment_taskId_idx")
}

/// One row per recipient per event — the feed is fanned out on write so
/// reading it is a single indexed scan with no joins.
///
/// `title`, `body` and `url` are rendered when the event happens rather than
/// derived at read time. That keeps the feed query cheap, and means a
/// notification still says what it said when it arrived even after the task
/// has been renamed or moved.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  /// Who sees it.
  userId    String           @db.Uuid
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Who caused it. Null for system events such as the due-date digest.
  actorId   String?          @db.Uuid
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  body      String?
  /// Where clicking it goes, so a new type never needs a client-side URL rule.
  url       String
  taskId    String?          @db.Uuid
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId String?          @db.Uuid
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "Notification_userId_createdAt_idx")
  @@index([taskId], map: "Notification_taskId_idx")
}

/// Personal access token for the hosted MCP endpoint.
///
/// Only the hash is stored, so the plaintext exists exactly once — in the
/// response that created it. `prefix` is the visible stub the settings screen
/// lists a token by.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId], map: "ApiToken_userId_idx")
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  filename  String
  url       String
  fileSize  Int
  mimeType  String
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([taskId], map: "Attachment_taskId_idx")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  color     String?
  tasks     TaskTag[]
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
}

model TaskTag {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId], map: "TaskTag_taskId_tagId_key")
}
